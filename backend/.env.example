NODE_ENV=development
PORT=9090
POSTGRES_DB=litmun
POSTGRES_USER=litmun
POSTGRES_PASSWORD=litmun_dev_only
DATABASE_URL=postgresql://litmun:litmun_dev_only@localhost:5432/litmun?schema=public
FRONTEND_ORIGINS=http://localhost:9090,http://localhost:5173
STATIC_DIR=../frontend/dist
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_DAYS=14
COOKIE_SECURE=
APP_BASE_URL=http://localhost:9090

